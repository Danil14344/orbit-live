# Read-only API keys for Binance / Bybit / OKX / MEXC
# Создавай ключи ТОЛЬКО с правом "Read" — без trade, без withdraw.
# Лучше дополнительно привязать к IP.
# Скопируй этот файл в .env и заполни поля.

BINANCE_API_KEY=
BINANCE_SECRET=

BYBIT_API_KEY=
BYBIT_SECRET=

OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=

MEXC_API_KEY=
MEXC_SECRET=

# Эти три уже отдают данные без ключей, можно не заполнять:
GATE_API_KEY=
GATE_SECRET=
KUCOIN_API_KEY=
KUCOIN_SECRET=
KUCOIN_PASSWORD=
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=

# Telegram bot (optional) — control, balances, PnL & open/close notifications
# Создай бота в @BotFather и вставь токен. chat_id можно оставить пустым —
# первый, кто напишет /start, привяжется автоматически.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_OPENS=1
# Опционально: заранее заданный JWT аккаунта (иначе вход через /login в боте):
EYECRYPT_ACCOUNT_TOKEN=
# Публичный HTTPS-адрес локального дашборда (Cloudflare-туннель) —
# включает кнопку «Кабинет» (Telegram Mini App в стиле сайта):
TELEGRAM_MINIAPP_URL=
